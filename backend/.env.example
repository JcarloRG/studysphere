# Copia este archivo a ".env" y rellena los valores reales.
# ".env" está en .gitignore: NUNCA debe subirse al repositorio.

# ==================== Django ====================
# Genera una con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ==================== Base de datos (PostgreSQL) ====================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ==================== Correo (SMTP Gmail) ====================
# Usa una cuenta con 2FA + contraseña de aplicación (nunca tu contraseña normal).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ==================== Frontend ====================
FRONTEND_BASE_URL=http://localhost:3000

# ==================== Dominios de correo permitidos ====================
ALLOWED_EMAIL_DOMAINS=
BLOCKED_EMAIL_DOMAINS=

# ==================== CORS ====================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# ==================== Verificación de correo ====================
EMAIL_VERIFICATION_EXP_MINUTES=15

# ==================== JWT (sesiones de estudiante/docente/egresado) ====================
JWT_ACCESS_LIFETIME_HOURS=2
JWT_REFRESH_LIFETIME_DAYS=7
